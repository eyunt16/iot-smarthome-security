PORT=5000
FRONTEND_ORIGIN=[https://iot-smarthome-security.onrender.com](https://iot-smarthome-security.onrender.com)
MONGODB_URI=mongodb://127.0.0.1:27017/iot_smart_home
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=12h
JWT_ISSUER=iot-smart-home-api
JWT_AUDIENCE=iot-smart-home-clients
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=alerts@example.com
ADMIN_EMAIL=superadmin@example.com
